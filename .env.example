# Secret keys managed in Infisical and synced to Cloudflare Workers
# Do not commit real values to git. Run: npm run secrets:sync

# 1. X Webhook CRC & HMAC-SHA256 verification (src/x-webhook.mjs)
X_OAUTH2_CLIENT_SECRET=
X_API_KEY_SECRET=
X_BEARER_TOKEN=

# 2. Joint Google AI Judge (Decisions API gemini-decision-1 + Gemini 3.8 Flash)
# Single Google AI Studio / GCP-billed Gemini API key covers both models
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# DECISIONS_MODEL=gemini-decision-1
# FLASH_MODEL=gemini-3.8-flash
# ARBITRATOR_MODEL=gemini-4-neon
# ENABLE_TIER2_ARBITRATOR=true

# Optional joint consensus policy: "strict" (both must agree, default) or "fallback"
# JOINT_JUDGE_MODE=strict

# 3. Optional admin API & downstream alerts
ADMIN_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@antigravity-resets.com
