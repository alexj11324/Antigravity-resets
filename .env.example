# Secret keys managed in Infisical and synced to Cloudflare Workers
# Do not commit real values to git. Run: npm run secrets:sync

# 1. X Webhook CRC & HMAC-SHA256 verification (src/x-webhook.mjs)
X_OAUTH2_CLIENT_SECRET=
X_API_KEY_SECRET=
X_BEARER_TOKEN=

# Public reset posts use a separate X app with Read and Write permissions and
# user credentials for @agy_resets. Set the UTC activation timestamp last.
X_POST_API_KEY=
X_POST_API_KEY_SECRET=
X_POST_ACCESS_TOKEN=
X_POST_ACCESS_TOKEN_SECRET=
X_POSTS_START_AT=

# 2. Joint Google AI Judge (Decisions API gemini-decision-1 + Gemini 3.8 Flash)
# Single Google AI Studio / GCP-billed Gemini API key covers both models
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# DECISIONS_MODEL=gemini-decision-1
# FLASH_MODEL=gemini-3.8-flash
# ARBITRATOR_MODEL=gemini-4-neon
# ENABLE_TIER2_ARBITRATOR=true

# Optional joint consensus policy: "strict" (both must agree, default) or "fallback"
# JOINT_JUDGE_MODE=strict

# 3. Unsubscribe link signing. Falls back to X_OAUTH2_CLIENT_SECRET when unset;
# without either secret the unsubscribe endpoint returns 503 rather than
# accepting an unsigned request.
EMAIL_UNSUBSCRIBE_SECRET=

# Optional sender address when delivering through Cloudflare Email Sending.
# Defaults to RESEND_FROM_EMAIL, then alerts@antigravity-resets.com.
EMAIL_FROM=

# 4. Optional admin API & downstream alerts
ADMIN_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@antigravity-resets.com

# 5. Search-engine push (Bing/Copilot, Yandex, Naver).
# Prefer the authenticated Bing Webmaster Tools key: verify the site at
# https://www.bing.com/webmasters, then copy the API key from Settings > API
# access. When set, the cron uses SubmitUrlbatch instead of anonymous IndexNow.
BING_WEBMASTER_API_KEY=
# Anonymous IndexNow. The key is public by design: the Worker serves it at
# /<key>.txt to prove host control. Without either key, pushes are disabled.
INDEXNOW_KEY=
